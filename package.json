{
  "name": "peerdeliver",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "shared:build": "npm run build -w @peerdeliver/shared",
    "server": "npm run dev -w @peerdeliver/server",
    "app": "npm run start -w @peerdeliver/app",
    "db:generate": "prisma generate --schema packages/server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/server/prisma/schema.prisma",
    "typecheck": "tsc -p packages/server/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.scripts.json --noEmit && tsc -p packages/app/tsconfig.json --noEmit",
    "verify": "npm run db:generate && npm run typecheck && echo \"\\n\u2705 GREEN \u2014 types clean across server and app\"",
    "preflight": "node scripts/preflight.mjs",
    "seed:testusers": "node scripts/seed-test-users.mjs",
    "price:check": "npm run shared:build && node scripts/price-sanity.mjs",
    "stripe:test": "node scripts/stripe-e2e.mjs",
    "waitlist": "cd packages/server && npx tsx scripts/waitlist.ts",
    "payment:battle": "npm run shared:build --silent && node scripts/payment-battle.mjs",
    "payment:trace": "cd packages/server && npx tsx scripts/payment-trace.ts",
    "status": "node scripts/status.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "payment:stripe": "cd packages/server && npx tsx scripts/payment-trace.ts --stripe",
    "match:why": "cd packages/server && npx tsx scripts/match-why.ts",
    "payout:retry": "cd packages/server && npx tsx scripts/payout-retry.ts",
    "e2e:seed": "cd packages/server && npx tsx scripts/seed-e2e-users.ts",
    "e2e": "node scripts/e2e.mjs",
    "verify:all": "npm run shared:build && npm run typecheck && node scripts/preflight.mjs && npm run contrast && node scripts/price-sanity.mjs && node scripts/payment-battle.mjs",
    "e2e:ui": "maestro test .maestro"
  },
  "prisma": {
    "schema": "packages/server/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=18"
  }
}
