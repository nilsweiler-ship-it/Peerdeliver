# Every env file, however it is named. A backup copy made during a one-off
# edit — .env.backup — was not matched by the two explicit entries that used
# to be here, got committed with real keys in it, and was only caught by
# GitHub's push protection. The example file is the one deliberate exception.
.env
.env.*
!.env.example
*.log
.DS_Store
.expo/
ios/
android/
*.tsbuildinfo
coverage/
.turbo/
.claude/
shlep_ch_deploy.zip

# Xcode build logs (generated when debugging native builds)
xcode-build.log
*.xcresult

# EAS / store credentials — never commit
google-play-key.json
*.p8
*.p12
*.mobileprovision

# Local Netlify folder
.netlify
.stripe-e2e-account
