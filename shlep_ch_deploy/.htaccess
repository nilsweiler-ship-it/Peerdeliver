# Shlep — Hostpoint (Apache)
# Keep old extensionless URLs working (previous deploy linked /legal?doc=...)
RewriteEngine On
RewriteRule ^legal$ legal.html [L,QSA]
RewriteRule ^kontakt$ kontakt.html [L,QSA]

# Sensible caching: HTML fresh, assets long-lived
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

# UTF-8 everywhere
AddDefaultCharset UTF-8
