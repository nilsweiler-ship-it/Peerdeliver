DATABASE_URL="postgresql://peerdeliver:peerdeliver_dev@localhost:5432/peerdeliver"
JWT_SECRET="change-me-to-a-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"
PORT=3001
NODE_ENV=development

# Platform commission % (taken from each delivery budget).
PLATFORM_FEE_PERCENT=9
PLATFORM_FEE_MIN_CHF=1.5

# ── Payments ──────────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY unset → SIMULATED TWINT (no processor; demo works).
# Set it → REAL mode: Stripe PaymentIntents (TWINT + card) + Connect payouts.
#   Test keys: https://dashboard.stripe.com/test/apikeys  (enable TWINT in
#   Settings → Payment methods). Webhook secret from:
#   stripe listen --forward-to localhost:3001/webhooks/stripe
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."   # also set app.json extra.stripePublishableKey
# STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_COUNTRY="CH"

# Partner widget (publishable, read-only quote keys) — format: name:key,name2:key2
PARTNER_API_KEYS=demo:pk_demo_shlep_2026
PARTNER_DEEPLINK_BASE=https://shlep.ch
PARTNER_MAX_DISTANCE_KM=150
