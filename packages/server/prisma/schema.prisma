generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  sender
  driver
  both
  recipient
  admin
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum DeliveryStatus {
  pending
  /// A driver asked to take this delivery; the sender must confirm.
  requested
  /// The sender picked a specific driver's published route and is waiting for
  /// that driver to accept. The mirror image of `requested`, and deliberately
  /// a separate state: overloading `requested` would make it impossible to tell
  /// who is waiting on whom, and both sides show a different screen.
  offered
  matched
  accepted
  picked_up
  in_transit
  delivered
  cancelled
  expired
}

enum PackageSize {
  S
  M
  L
}

enum RouteType {
  one_time
  recurring
}

enum Packaging {
  none
  reused
  cardboard
  other
}

enum PaymentStatus {
  unpaid
  authorised
  captured
  refunded
  voided
  failed
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole
  phone              String?
  avatarUrl          String?
  bio                String?
  licensePlate       String?
  carModel           String?
  maxLoadKg          Float?
  vehicleSize        PackageSize?
  shareLocation      Boolean            @default(true)
  /// Expo push token for this user's device. Null until they grant permission.
  /// One token per user: re-registering on a new device replaces the old one.
  expoPushToken      String?
  verificationStatus VerificationStatus @default(unverified)
  phoneVerified      Boolean            @default(false)
  idVerified         Boolean            @default(false)
  plateVerified      Boolean            @default(false)
  stripeAccountId        String?
  stripePayoutsEnabled   Boolean         @default(false)
  stripeDetailsSubmitted Boolean         @default(false)
  averageRating      Float?
  totalRatings       Int                @default(0)
  totalDeliveries    Int                @default(0)
  co2Saved           Float              @default(0)
  language           String             @default("en")
  refreshToken       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sentDeliveries     DeliveryRequest[] @relation("SenderDeliveries")
  drivenDeliveries   DeliveryRequest[] @relation("DriverDeliveries")
  receivedDeliveries DeliveryRequest[] @relation("RecipientDeliveries")
  routes             DriverRoute[]
  sentMessages       Message[]
  ratingsGiven       Rating[]          @relation("RatingsGiven")
  ratingsReceived    Rating[]          @relation("RatingsReceived")

  @@map("users")
}

model DeliveryRequest {
  id                  String         @id @default(uuid())
  senderId            String
  sender              User           @relation("SenderDeliveries", fields: [senderId], references: [id])
  driverId            String?
  driver              User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  recipientId         String?
  recipient           User?          @relation("RecipientDeliveries", fields: [recipientId], references: [id])
  recipientEmail      String?
  /// Either an email or a phone reaches the recipient. Phone is often the only
  /// thing a sender has for someone they met on a marketplace, and an SMS is
  /// more likely to be read before a handover than an email.
  recipientPhone      String?
  pickupLabel         String
  pickupPoint         Unsupported("geometry(Point, 4326)")
  deliveryLabel       String
  deliveryPoint       Unsupported("geometry(Point, 4326)")
  packageSize         PackageSize
  packageWeight       Float?
  packageDescription  String?
  /// What the parcel is wrapped in. Feeds the CO2 figure: a delivery handed
  /// over unpackaged, or in reused material, avoids the embodied emissions of
  /// a new box that a courier shipment would have required.
  packaging           Packaging?
  declaredValue       Float?
  budgetCHF           Float
  platformFeeCHF      Float?
  deliveryWindowStart DateTime
  deliveryWindowEnd   DateTime
  status              DeliveryStatus @default(pending)
  /// Which published route the sender targeted, when the match was
  /// sender-initiated. Intentionally a plain id rather than a relation: a
  /// driver deleting a route must not be blocked by, or cascade into, an open
  /// offer. Cleared when the offer is accepted or declined.
  offeredRouteId      String?
  pickupCode          String?
  deliveryCode        String?
  co2SavedKg          Float?
  cancelledBy         String?
  cancelReason        String?
  twintRef              String?
  twintPhone            String?
  stripePaymentIntentId String?
  stripeTransferId      String?
  /// Payrexx hosted-payment gateway id (real TWINT). The transaction id only
  /// exists once the payer has actually completed the payment.
  payrexxGatewayId      String?
  payrexxTransactionId  String?
  paymentStatus         PaymentStatus  @default(unpaid)
  driverPayoutCHF       Float?
  refundedCHF           Float?
  refundedAt            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  messages Message[]
  ratings  Rating[]

  @@index([senderId])
  @@index([driverId])
  @@index([recipientId])
  @@index([status])
  @@map("delivery_requests")
}

model DriverRoute {
  id                 String    @id @default(uuid())
  driverId           String
  driver             User      @relation(fields: [driverId], references: [id])
  originAddress      String
  originPoint        Unsupported("geometry(Point, 4326)")
  destinationAddress String
  destinationPoint   Unsupported("geometry(Point, 4326)")
  routeType          RouteType
  departureTime      DateTime
  recurringDays      String[]
  availableSize      PackageSize
  maxDetourMinutes   Int       @default(15)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([driverId])
  @@index([isActive])
  @@map("driver_routes")
}

model Message {
  id                String          @id @default(uuid())
  deliveryRequestId String
  deliveryRequest   DeliveryRequest @relation(fields: [deliveryRequestId], references: [id])
  senderId          String
  sender            User            @relation(fields: [senderId], references: [id])
  content           String
  readAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([deliveryRequestId])
  @@index([senderId])
  @@map("messages")
}

model Rating {
  id                String          @id @default(uuid())
  deliveryRequestId String
  deliveryRequest   DeliveryRequest @relation(fields: [deliveryRequestId], references: [id])
  fromUserId        String
  fromUser          User            @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUserId          String
  toUser            User            @relation("RatingsReceived", fields: [toUserId], references: [id])
  score             Int
  comment           String?
  createdAt         DateTime        @default(now())

  @@unique([deliveryRequestId, fromUserId])
  @@index([toUserId])
  @@map("ratings")
}

/// Waitlist signups from the marketing site. Kept separate from User: these are
/// leads, not accounts, and most will never register. `email` is unique so a
/// repeat signup updates rather than duplicates.
model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String? // "sender" | "driver" | "both" — what they clicked
  language  String   @default("de")
  source    String   @default("website") // website | partner | /new deep link
  routeHint String? // free text from the /new flow, e.g. "Zürich → Bern"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("waitlist_signups")
}

/// Messages from the Kontakt form. Stored so nothing is lost if mail delivery
/// fails — the notification email is a convenience, this table is the record.
model ContactMessage {
  id        String    @id @default(uuid())
  name      String?
  email     String
  topic     String?
  message   String
  language  String    @default("de")
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}
